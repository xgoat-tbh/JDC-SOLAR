# ==============================================================================
# JDC SOLAR 2.0 - PRODUCTION HOSTINGER / APACHE OPTIMIZED CONFIGURATION
# ==============================================================================

# 1. Directory Index
DirectoryIndex index.html index.php

# 2. Prevent Directory Listing Safely
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# 3. Ensure Modern MIME Types
<IfModule mod_mime.c>
  AddType text/html .html
  AddType text/css .css
  AddType application/javascript .js
  AddType application/json .json
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg .svgz
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/x-icon .ico
  AddType application/manifest+json .webmanifest
</IfModule>

# 4. Block Access to Hidden & Sensitive Files (.git, .env, *.bak, *.sql, package.json)
<FilesMatch "(^\.|\.env|package\.json|package-lock\.json|\.bak|\.sql|\.log|\.md|\.py|\.sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 5. Block Direct Web Access to Monorepo Development Directories (if present)
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(research|tests|docs|scripts|scratch)/
</IfModule>

# 6. Rewrite Engine Rules
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce HTTPS (compatible with direct SSL & Hostinger/Cloudflare reverse proxies)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Enforce Non-WWW (strip www.)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Transparent WebP fallback: serve .webp if a .jpg/.jpeg is requested and .webp exists
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
  RewriteRule ^(.*)\.(?:jpe?g)$ /$1.webp [L,T=image/webp]

  # Legacy 301 Permanent Redirects
  RewriteRule ^about-us/?$ /about/ [L,R=301]
  RewriteRule ^contact-us/?$ /contact/ [L,R=301]
  RewriteRule ^project/?$ /projects/ [L,R=301]
  RewriteRule ^our-projects/?$ /projects/ [L,R=301]
  RewriteRule ^calculator/?$ /solar-calculator/ [L,R=301]
  RewriteRule ^detail-service/?$ /services/ [L,R=301]
  RewriteRule ^team/?$ /about/ [L,R=301]
  RewriteRule ^elementor-9/?$ / [L,R=301]
  RewriteRule ^residential-solar/?$ /services/residential-solar/ [L,R=301]
  RewriteRule ^commercial-solar/?$ /services/commercial-solar/ [L,R=301]
  RewriteRule ^industrial-solar/?$ /services/industrial-solar/ [L,R=301]
  RewriteRule ^solar-water-pump/?$ /services/ [L,R=301]
  RewriteRule ^faqs?/?$ /resources/ [L,R=301]

  # Strip Legacy WordPress Query Strings
  RewriteCond %{QUERY_STRING} ^wpr_templates= [NC]
  RewriteRule ^(.*)$ /? [L,R=301]

  # Clean Trailing Slash Normalization for Directories
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

# 7. Custom Error Documents
ErrorDocument 404 /404.html
ErrorDocument 500 /404.html

# 8. Production Security Headers
<IfModule mod_headers.c>
  # Clickjacking Protection
  Header set X-Frame-Options "SAMEORIGIN"
  
  # MIME-Sniffing Protection
  Header set X-Content-Type-Options "nosniff"
  
  # Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Permissions Policy
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  
  # HTTP Strict Transport Security (1 Year with Preload)
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  
  # Unset PHP/Server Signature Exposure
  Header unset X-Powered-By
  
  # Content Security Policy (Self-hosted fonts, WhatsApp, Formspree)
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://wa.me https://api.whatsapp.com https://formspree.io https://*.formspree.io; frame-ancestors 'self';"
</IfModule>

# 9. Browser Caching & Expiration
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML - always revalidate
  ExpiresByType text/html "access plus 0 seconds"

  # Images & SVG - 1 year
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts - 1 year immutable
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"

  # Stylesheets & Scripts (1 week with must-revalidate so updates deploy smoothly)
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# 10. Cache-Control Headers
<IfModule mod_headers.c>
  # Fonts (completely immutable)
  <FilesMatch "\.(woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images & Media
  <FilesMatch "\.(png|jpg|jpeg|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, stale-while-revalidate=86400"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # CSS & JS (Cached for performance, but allows smooth updates)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>

  # HTML always revalidates
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Proper content negotiation
  Header append Vary Accept-Encoding
</IfModule>

# 11. Brotli & Gzip Compression
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml font/ttf font/otf font/eot
</IfModule>
