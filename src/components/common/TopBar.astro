  <div class="container flex flex--between">
    <div class="header-topbar__trust-badge">
      <svg class="icon" style="width: 14px; height: 14px; color: var(--color-brand-accent-text, #C25E00);" aria-hidden="true"><use href="/assets/icons/sprite.svg#icon-sun"></use></svg>
      <span>A Jagatdhan Commodities Pvt. Ltd. Company</span>
      <span>•</span>
      <span>Jharkhand's Premier Solar EPC Partner</span>
    </div>
    <div class="flex gap-md">
      <a href="tel:+919288381112" style="display: inline-flex; align-items: center; gap: 6px;">
        <svg class="icon" style="width: 14px; height: 14px; color: var(--color-brand-accent-text, #C25E00);" aria-hidden="true"><use href="/assets/icons/sprite.svg#icon-phone"></use></svg>
        <span>+91 92883 81112</span>
      </a>
      <a href="mailto:sales@jdcsolar.com" style="display: inline-flex; align-items: center; gap: 6px;">
        <svg class="icon" style="width: 14px; height: 14px; color: var(--color-brand-accent-text, #C25E00);" aria-hidden="true"><use href="/assets/icons/sprite.svg#icon-email"></use></svg>
