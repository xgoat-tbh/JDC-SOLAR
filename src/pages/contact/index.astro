---
// src/pages/contact/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact JDC Solar",
  "url": "https://jdcsolar.com/contact/",
  "mainEntity": {
    "@type": "LocalBusiness",
    "name": "JDC Solar",
    "telephone": "+91-9288381112",
    "email": "sales@jdcsolar.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "A-21, 2nd Phase, Industrial Area, Adityapur",
      "addressLocality": "Jamshedpur",
      "addressRegion": "Jharkhand",
      "postalCode": "832109",
      "addressCountry": "IN"
    }
  }
};
---

<BaseLayout
  title="Contact JDC Solar | Rooftop Solar EPC & Free Site Survey | Jamshedpur"
  description="Contact JDC Solar engineers in Adityapur Jamshedpur. Schedule a free on-site rooftop survey, 3D shadow analysis, and PM Surya Ghar subsidy estimate."
  canonical="https://jdcsolar.com/contact/"
  activeNav="contact"
  schema={contactSchema}
>
  <section class="page-hero page-hero--contact" aria-label="Contact JDC Solar">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumbs">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item"><a href="/" class="breadcrumb__link">Home</a></li>
          <li class="breadcrumb__separator" aria-hidden="true">/</li>
          <li class="breadcrumb__item" aria-current="page">Contact Us</li>
        </ol>
      </nav>

      <div class="page-hero__badge">
        <div class="badge--saas-pulse">
          <span class="badge-pulse-dot"><span class="badge-pulse-dot__ping"></span><span class="badge-pulse-dot__core"></span></span>
          <span>Free On-Site Rooftop Survey</span>
        </div>
      </div>
      <h1 class="display-title page-hero__title">
        Let's Engineer Your Solar Power Plant
      </h1>
      <p class="lead page-hero__lead">
        Connect with our solar EPC engineers in Adityapur Industrial Area. Schedule a site inspection, get 3D shadow analysis, and receive a customized financial proposal.
      </p>
      <div class="page-hero__chips">
        <div class="page-hero__chip">
          <svg class="icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#icon-clock"></use></svg>
          <span>2-Hour WhatsApp Response</span>
        </div>
        <div class="page-hero__chip">
          <svg class="icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#icon-shield"></use></svg>
          <span>MNRE Verified Channel Partner</span>
        </div>
        <div class="page-hero__chip">
          <svg class="icon" aria-hidden="true"><use href="/assets/icons/sprite.svg#icon-check"></use></svg>
          <span>100% Free Site Feasibility</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--2col grid--gap-xl" style="align-items: start;">
        <div>
          <div class="section-tag section-tag--accent">DIRECT ENGINEERING DESK</div>
          <h2 style="font-size: 1.85rem; margin-bottom: 1.5rem;">Get in Touch With Our EPC Team</h2>
          <p style="color: var(--color-text-secondary); line-height: 1.7; margin-bottom: 2rem;">
            Whether you are looking to solarize a residential bungalow in Ranchi, an industrial factory in Adityapur, or a hospital in Bokaro, our certified engineers are ready to assist.
          </p>

          <div class="flex flex--column gap-lg">
            <div class="card" style="display: flex; gap: var(--space-md); align-items: flex-start;">
              <div style="font-size: 1.5rem; color: var(--color-brand-accent-text, #C25E00);">
                <svg class="icon" style="width: 28px; height: 28px;"><use href="/assets/icons/sprite.svg#icon-location"></use></svg>
              </div>
              <div>
                <h3 style="font-size: 1.1rem; margin-bottom: 0.25rem;">Engineering Headquarters</h3>
                <p class="text-small text-muted" style="line-height: 1.5; margin-bottom: 0.5rem;">
                  JDC Solar / Jagatdhan Commodities Pvt. Ltd.<br>
                  A-21, 2nd Phase, Industrial Area, Adityapur, Jamshedpur, Jharkhand 832109
                </p>
                <span class="badge badge--outline" style="font-size: 0.75rem;">Mon - Sat: 9:30 AM - 6:30 PM</span>
              </div>
            </div>

            <div class="card" style="display: flex; gap: var(--space-md); align-items: flex-start;">
              <div style="font-size: 1.5rem; color: var(--color-brand-accent-text, #C25E00);">
                <svg class="icon" style="width: 28px; height: 28px;"><use href="/assets/icons/sprite.svg#icon-phone"></use></svg>
              </div>
              <div>
                <h3 style="font-size: 1.1rem; margin-bottom: 0.25rem;">Phone Hotline</h3>
                <p class="text-small text-muted" style="margin-bottom: 0.25rem;">Direct Line: <a href="tel:+919288381112" style="color: var(--color-brand-accent-text, #C25E00); font-weight: 600;">+91 92883 81112</a></p>
                <p class="text-small text-muted">WhatsApp: <a href="https://wa.me/919288381112" target="_blank" rel="noopener noreferrer" style="color: #25D366; font-weight: 600;">+91 92883 81112</a></p>
              </div>
            </div>

            <div class="card" style="display: flex; gap: var(--space-md); align-items: flex-start;">
              <div style="font-size: 1.5rem; color: var(--color-brand-accent-text, #C25E00);">
                <svg class="icon" style="width: 28px; height: 28px;"><use href="/assets/icons/sprite.svg#icon-email"></use></svg>
              </div>
              <div>
                <h3 style="font-size: 1.1rem; margin-bottom: 0.25rem;">Email Inquiries</h3>
                <p class="text-small text-muted" style="margin-bottom: 0.25rem;">Sales & Tenders: <a href="mailto:sales@jdcsolar.com" style="color: var(--color-brand-accent-text, #C25E00); font-weight: 600;">sales@jdcsolar.com</a></p>
                <p class="text-small text-muted">General & Corporate: <a href="mailto:info@jdcsolar.com" style="color: var(--color-brand-accent-text, #C25E00); font-weight: 600;">info@jdcsolar.com</a></p>
              </div>
            </div>
          </div>
        </div>

        <div class="card">
          <span class="section-overline">FREE ROOFTOP SURVEY</span>
          <h2 style="font-size: 1.4rem; margin-bottom: 0.5rem;">Book an On-Site Rooftop Inspection</h2>
          <p class="text-small text-muted" style="margin-bottom: 1.5rem;">
            Fill out the details below. Our technical team in Adityapur will inspect your roof topography, conduct a 3D shadow analysis, and prepare an exact proposal.
          </p>

          <form action="https://formspree.io/f/xyzkpvwr" method="POST" class="flex flex-col gap-4">
            <div class="form-group">
              <label class="form-label" for="contact-name">Full Name <span class="text-brand-accent">*</span></label>
              <input type="text" id="contact-name" name="name" class="form-control" placeholder="e.g. Rajesh Sharma" autocomplete="name" required>
            </div>

            <div class="form-group">
              <label class="form-label" for="contact-phone">Mobile Phone (10 Digits) <span class="text-brand-accent">*</span></label>
              <input type="tel" id="contact-phone" name="phone" pattern="[0-9]{10}" class="form-control" placeholder="e.g. 9876543210" autocomplete="tel" required>
            </div>

            <div class="form-group">
              <label class="form-label" for="contact-service">Solar Installation Type <span class="text-brand-accent">*</span></label>
              <select id="contact-service" name="service" class="form-select" required>
                <option value="Residential Rooftop Solar" selected>Residential Rooftop Solar</option>
                <option value="Commercial & Industrial Solar">Commercial & Industrial Solar</option>
                <option value="Institutional Solar (Hospital/School)">Institutional Solar (Hospital/School)</option>
                <option value="Government & Tender EPC">Government & Tender EPC</option>
                <option value="Solar Street Lighting">Solar Street Lighting</option>
                <option value="Utility Solar Parks">Utility Solar Parks</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="contact-city">City / Pincode in Jharkhand <span class="text-brand-accent">*</span></label>
              <input type="text" id="contact-city" name="city" class="form-control" placeholder="e.g. Jamshedpur, 831001" autocomplete="address-level2" required>
            </div>

            <div class="form-group">
              <label class="form-label" for="contact-message">Project Details / Roof Area <span class="text-muted">(Optional)</span></label>
              <textarea id="contact-message" name="message" class="form-control" rows="3" placeholder="e.g. Looking for a 5 kW rooftop system for my home in Morabadi, Ranchi." maxlength="500"></textarea>
            </div>

            <div style="font-size: 0.8rem; color: var(--color-text-muted); margin-bottom: 0.5rem;">
              By submitting this form, you agree to our <a href="/privacy-policy/" style="color: var(--color-brand-accent-text, #C25E00); text-decoration: underline;">Privacy Policy</a>. We never share your contact details.
            </div>

            <button type="submit" class="btn btn--primary btn--block btn--lg">
              Book Free Consultation & Site Survey →
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Presence -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-overline">REGIONAL PRESENCE</span>
        <h2>Our Offices Across Eastern India</h2>
        <p class="lead">Visit our engineering headquarters or regional branch offices in Jharkhand, West Bengal, and Odisha.</p>
      </div>

      <div class="regional-offices-grid">
        <div class="regional-office-card regional-office-card--hq">
          <span class="regional-office-card__badge">Corporate HQ</span>
          <div class="regional-office-card__header">
            <div class="regional-office-card__icon">
              <svg class="icon"><use href="/assets/icons/sprite.svg#icon-location"></use></svg>
            </div>
            <div>
              <h3 class="regional-office-card__state">Jharkhand</h3>
            </div>
          </div>
          <p class="regional-office-card__address">
            <strong>JDC Solar Engineering Headquarters</strong><br>
            A-21 2nd Phase, Industrial Area, Adityapur, Jamshedpur, Jharkhand 832109
          </p>
          <div class="regional-office-card__coverage">
            <strong>Coverage:</strong> Jamshedpur, Ranchi, Dhanbad, Bokaro & State-wide EPC
          </div>
          <div class="regional-office-card__actions">
            <a href="https://maps.google.com/?q=A-21+2nd+Phase+Industrial+Area+Adityapur+Jamshedpur+Jharkhand+832109" target="_blank" rel="noopener noreferrer" class="regional-office-card__link">
              <span>Get Directions</span>
              <svg class="icon"><use href="/assets/icons/sprite.svg#icon-arrow-right"></use></svg>
            </a>
            <a href="tel:+919288381112" class="btn btn--secondary btn--sm">Call Office</a>
          </div>
        </div>

        <div class="regional-office-card">
          <span class="regional-office-card__badge">Regional Branch</span>
          <div class="regional-office-card__header">
            <div class="regional-office-card__icon">
              <svg class="icon"><use href="/assets/icons/sprite.svg#icon-location"></use></svg>
            </div>
            <div>
              <h3 class="regional-office-card__state">West Bengal</h3>
            </div>
          </div>
          <p class="regional-office-card__address">
            <strong>Kolkata Branch Office</strong><br>
            A/52/1, Baghajatin Colony, Near I Block More, Kolkata, West Bengal 700092
          </p>
          <div class="regional-office-card__coverage">
            <strong>Coverage:</strong> Greater Kolkata, Howrah, Durgapur, Asansol & South Bengal
          </div>
          <div class="regional-office-card__actions">
            <a href="https://maps.google.com/?q=A/52/1+Baghajatin+Colony+Near+I+Block+More+Kolkata+700092" target="_blank" rel="noopener noreferrer" class="regional-office-card__link">
              <span>Get Directions</span>
              <svg class="icon"><use href="/assets/icons/sprite.svg#icon-arrow-right"></use></svg>
            </a>
            <a href="tel:+919288381112" class="btn btn--secondary btn--sm">Call Office</a>
          </div>
        </div>

        <div class="regional-office-card">
          <span class="regional-office-card__badge">Regional Branch</span>
          <div class="regional-office-card__header">
            <div class="regional-office-card__icon">
              <svg class="icon"><use href="/assets/icons/sprite.svg#icon-location"></use></svg>
            </div>
            <div>
              <h3 class="regional-office-card__state">Odisha</h3>
            </div>
          </div>
          <p class="regional-office-card__address">
            <strong>Bhubaneswar Branch Office</strong><br>
            New Capital Bhubaneswar, Near Siv Temple, Naharakanta, Khordha, Bhubaneswar, Odisha 752101
          </p>
          <div class="regional-office-card__coverage">
            <strong>Coverage:</strong> Bhubaneswar, Cuttack, Rourkela, Khordha & Coastal Belt
          </div>
          <div class="regional-office-card__actions">
            <a href="https://maps.google.com/?q=Naharakanta+Khordha+Bhubaneswar+Odisha+752101" target="_blank" rel="noopener noreferrer" class="regional-office-card__link">
              <span>Get Directions</span>
              <svg class="icon"><use href="/assets/icons/sprite.svg#icon-arrow-right"></use></svg>
            </a>
            <a href="tel:+919288381112" class="btn btn--secondary btn--sm">Call Office</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="section">
    <div class="container container--medium">
      <div class="section-header">
        <div class="section-tag section-tag--accent">FREQUENTLY ASKED QUESTIONS</div>
        <h2>Contact & Site Inspection Queries</h2>
      </div>

      <div class="accordion-group">
        <details class="accordion-item" open>
          <summary class="accordion-summary">
            <span>Is the rooftop site inspection truly free of cost?</span>
            <span class="accordion-summary__icon" aria-hidden="true">
              <svg class="icon"><use href="/assets/icons/sprite.svg#icon-chevron-down"></use></svg>
            </span>
          </summary>
          <div class="accordion-content">
            <p>Yes. Our preliminary site survey, 3D shadow simulation, and subsidy ROI proposal are 100% complimentary across Jamshedpur, Ranchi, Bokaro, Dhanbad, and surrounding districts in Jharkhand.</p>
          </div>
        </details>

        <details class="accordion-item">
          <summary class="accordion-summary">
            <span>How quickly can JDC Solar visit my location?</span>
            <span class="accordion-summary__icon" aria-hidden="true">
              <svg class="icon"><use href="/assets/icons/sprite.svg#icon-chevron-down"></use></svg>
            </span>
          </summary>
          <div class="accordion-content">
            <p>Our engineering team typically schedules site inspections within 24 to 48 hours of form submission or direct WhatsApp contact.</p>
          </div>
        </details>

        <details class="accordion-item">
          <summary class="accordion-summary">
            <span>Can I schedule an appointment directly at your Adityapur HQ?</span>
            <span class="accordion-summary__icon" aria-hidden="true">
              <svg class="icon"><use href="/assets/icons/sprite.svg#icon-chevron-down"></use></svg>
            </span>
          </summary>
          <div class="accordion-content">
            <p>Yes! Our regional engineering headquarters at A-21, 2nd Phase Industrial Area, Adityapur is open Monday to Saturday from 9:30 AM to 6:30 PM. Walk-ins are always welcome, or you can call us to reserve a dedicated engineering consultation.</p>
          </div>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
