# ==============================================================================
# JDC SOLAR 2.0 - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local environment overrides.
# NOTE: The core website is a static architecture; environment variables are
# used exclusively for build-time configuration, deployment, or serverless webhooks.
# DO NOT COMMIT REAL CREDENTIALS OR API SECRETS TO VERSION CONTROL.
# ==============================================================================

# Canonical Base URL
SITE_URL=https://jdcsolar.com

# Form Relay & Lead Capture Endpoint (Optional Formspree / Web3Forms Form ID)
# Example: https://formspree.io/f/xvgozkle
FORM_ENDPOINT_URL=https://formspree.io/f/your-form-id

# Primary Communication Numbers
PRIMARY_PHONE_DISPLAY="+91 92883 81112"
PRIMARY_PHONE_E164="+919288381112"
WHATSAPP_PHONE_NUMBER="919288381112"
PRIMARY_SALES_EMAIL="sales@jdcsolar.com"
PRIMARY_INFO_EMAIL="info@jdcsolar.com"

# Analytics & Measurement (Optional Google Tag Manager ID)
GTM_CONTAINER_ID="GTM-XXXXXXX"
